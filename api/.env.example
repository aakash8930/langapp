# Copy to .env and adjust. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3000

# MongoDB — docker compose service `mongo`, bound to localhost only.
# Host port is 27018 because 27017 is often taken by a system-level mongod.
MONGO_URI=mongodb://127.0.0.1:27018/langapp

# Redis — docker compose service `redis`, bound to localhost only
REDIS_URL=redis://127.0.0.1:6379

# JWT (§10) — must be >= 32 chars and different from each other.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48-output
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Rate limiting on /auth/* (§10) — Stage A exposes this publicly via Funnel.
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60

# Object storage root for the Stage A local StorageService. Relative paths
# resolve against the process working directory. Gitignored; not backed up.
STORAGE_DIR=./storage
