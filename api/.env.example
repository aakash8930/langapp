# Copy to .env and adjust. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3000

# MongoDB — docker compose service `mongo`, bound to localhost only.
# Host port is 27018 because 27017 is often taken by a system-level mongod.
MONGO_URI=mongodb://127.0.0.1:27018/langapp

# Redis — docker compose service `redis`, bound to localhost only
REDIS_URL=redis://127.0.0.1:6379

# JWT (§10) — must be >= 32 chars and different from each other.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48-output
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Rate limiting on /auth/* (§10) — Stage A exposes this publicly via Funnel.
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60

# Rate limiting on /chat/* (§10) — also the §8 cost guard: chat is the only
# surface that spends LLM provider quota per request.
CHAT_THROTTLE_LIMIT=10
CHAT_THROTTLE_TTL_SECONDS=60

# AI chat (§7) — Gemini free tier for Stage A (§8: ₹0 while testing).
# Create a free key at https://aistudio.google.com/apikey — no card needed.
# Leave empty to run without chat: everything else works, chat routes 503.
GEMINI_API_KEY=
# An alias, on purpose. Pinned model names retire — `gemini-2.5-flash` already
# 404s with "no longer available" — and named ones get overloaded: on 2026-07-22
# `gemini-3.5-flash` returned 503 UNAVAILABLE ("high demand") six times running
# on the free tier while `gemini-flash-latest` answered immediately. The alias
# tracks whatever flash model Google is actually serving.
# List what a key can use:
#   curl -s https://generativelanguage.googleapis.com/v1beta/models \
#     -H "x-goog-api-key: $GEMINI_API_KEY" | grep '"name"'
GEMINI_MODEL=gemini-flash-latest

# Object storage root for the Stage A local StorageService. Relative paths
# resolve against the process working directory. Gitignored; not backed up.
STORAGE_DIR=./storage

# XP for re-completing a lesson you have already finished. The first completion
# always awards XP_PER_LESSON_COMPLETION (10, a code constant) — this is the
# smaller practice award for every completion after that.
XP_PER_LESSON_PRACTICE=2

# Minutes before a lost heart comes back. Five hearts is the maximum; a wrong
# answer costs one and running out blocks nothing today except the learner's
# patience — there are no in-app purchases, so gems (earned by finishing
# lessons) are the only way to refill early. Duolingo uses hours because empty
# hearts are a sales funnel there; this app has nothing to sell, so the default
# is deliberately impatient.
HEARTS_REGEN_MINUTES=30

# Origins allowed to call this API from a browser, comma-separated. Empty (the
# default) sends no CORS headers, so a browser cannot read a response — which is
# how it behaved before the web/ site existed. The Expo app never needs this.
# Dev: http://localhost:5173,http://localhost:5175
CORS_ORIGINS=
