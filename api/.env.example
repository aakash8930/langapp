# Copy to .env and adjust. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3000

# MongoDB — docker compose service `mongo`, bound to localhost only.
# Host port is 27018 because 27017 is often taken by a system-level mongod.
MONGO_URI=mongodb://127.0.0.1:27018/langapp

# Redis — docker compose service `redis`, bound to localhost only
REDIS_URL=redis://127.0.0.1:6379

# JWT (§10) — must be >= 32 chars and different from each other.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48-output
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Rate limiting
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60
CHAT_THROTTLE_LIMIT=10
CHAT_THROTTLE_TTL_SECONDS=60

# AI chat (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Object storage
STORAGE_DIR=./storage
XP_PER_LESSON_PRACTICE=2

# Origins allowed to call this API from a browser, comma-separated.
CORS_ORIGINS=

# Transactional email. Without one of these, /health reports degraded and
# account verification/resets cannot be delivered. Resend wins if both are set.
RESEND_API_KEY=
MAIL_FROM=GENKŌ <noreply@genko.app>

# Dev-only fallback: Gmail SMTP via an App Password (needs 2-Step Verification
# enabled — generate one at myaccount.google.com/apppasswords). No domain to
# verify and no recipient restriction, unlike Resend's sandbox sender — the
# trade is Gmail's own ~500/day cap. SMTP_HOST/PORT default to Gmail's
# STARTTLS endpoint if left unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# One-time administrator bootstrap (`npm run seed:admin`). These values are
# read only by the bootstrap command; do not commit a real password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-unique-password
ADMIN_DISPLAY_NAME=LangApp Administrator
