# secrets
.env
.env.*
!.env.example

# deps & build
node_modules
dist
*.tsbuildinfo

# Local object storage written at runtime by LocalStorageService.
# Anchored with a leading slash on purpose: a bare `storage/` matches a directory
# of that name at ANY depth, which also excluded src/common/storage/ — the
# StorageService source itself — and broke the deploy build.
/api/storage/

# nightly mongodump output (scripts/backup.sh)
/backups/

# tooling
coverage
*.log
.DS_Store

# Local TTS toolchain (slice 3). Big, machine-specific, and rebuildable:
# `python3 -m venv tools/tts-venv` then install from tools/README.md.
tools/tts-venv/
# Kokoro model + voice bin — ~350MB of weights, downloaded not authored.
tools/voices/

# Dashboard layout reference: kept in-tree as docs/design-reference/platform-dashboard-layout.jpg
# for the web/ rebuild. Not authoritative — its pixel data is a JPEG mislabelled as PNG,
# and it's only a shape + palette reference (text labels / icons / typography are not in
# the image). If a higher-fidelity export lands, replace the file in place.
docs/design-reference/platform-dashboard-layout.jpg
