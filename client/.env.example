# Base URL of the GENKŌ API. No trailing slash.
#
# The API is served over Tailscale Funnel with valid TLS, so a phone running
# Expo Go can reach it without any cleartext or certificate workaround.
# Copy this file to .env and fill in your own funnel hostname.
EXPO_PUBLIC_API_URL=https://your-machine.your-tailnet.ts.net/langapp
